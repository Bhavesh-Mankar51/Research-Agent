# ---- LLM (Anthropic) ----
ANTHROPIC_API_KEY=sk-ant-...

# Model tiering. The orchestrator model does judgment (synthesis + verification);
# the worker model does the reading-heavy gathering. See docs/ARCHITECTURE.md.
ORCHESTRATOR_MODEL=claude-opus-5
WORKER_MODEL=claude-haiku-4-5
ORCHESTRATOR_EFFORT=medium

# ---- Composio ----
COMPOSIO_API_KEY=comp_...
# Composio user id the agent authenticates tool calls as.
COMPOSIO_USER_ID=research-agent
# Toolkits searched, in priority order, for web-search / scrape capability.
COMPOSIO_TOOLKITS=COMPOSIO_SEARCH,EXA,FIRECRAWL,TAVILY

# ---- Database ----
POSTGRES_USER=research
POSTGRES_PASSWORD=research
POSTGRES_DB=research
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---- Agent budget knobs (token control) ----
# Max Composio tool calls per research lane, per run.
MAX_TOOL_CALLS_PER_LANE=3
# Max characters of scraped text kept from any single source.
MAX_SOURCE_CHARS=6000
# Re-research loops allowed when verification finds gaps.
MAX_VERIFY_RETRIES=1
# Serve a cached report if one exists newer than this many hours. 0 disables.
REPORT_CACHE_TTL_HOURS=168

# ---- API ----
API_PORT=8000
CORS_ORIGINS=http://localhost:5173
